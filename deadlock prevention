#include <cstdlib>
#include <iomanip>
#include <iostream>
#include <memory>
#include <string>

#include <mysql_driver.h>
#include <mysql_connection.h>
#include <cppconn/driver.h>
#include <cppconn/connection.h>
#include <cppconn/prepared_statement.h>
#include <cppconn/resultset.h>
#include <cppconn/exception.h>

namespace {
const char* DB_HOST = "tcp://127.0.0.1:3306";
const char* DB_NAME = "exam_management";
const char* DB_USER = "root";

std::string getPassword() {
    const char* value = std::getenv("DB_PASSWORD");
    return value ? value : "";
}

std::unique_ptr<sql::Connection> connectDatabase() {
    auto* driver = sql::mysql::get_mysql_driver_instance();
    std::unique_ptr<sql::Connection> connection(
        driver->connect(DB_HOST, DB_USER, getPassword()));
    connection->setSchema(DB_NAME);
    return connection;
}

int readInteger(const std::string& prompt) {
    int value;
    std::cout << prompt;
    while (!(std::cin >> value)) {
        std::cin.clear();
        std::cin.ignore(10000, '\n');
        std::cout << "Please enter a valid number: ";
    }
    return value;
}

void roomWiseReport(sql::Connection& connection, int examId) {
    std::unique_ptr<sql::PreparedStatement> query(
        connection.prepareStatement(
            "SELECT e.exam_name, e.exam_date, r.room_name, r.capacity, "
            "COUNT(a.allocation_id) AS occupied "
            "FROM EXAM e "
            "JOIN ALLOCATION a ON a.exam_id = e.exam_id "
            "JOIN ROOM r ON r.room_id = a.room_id "
            "WHERE e.exam_id = ? "
            "GROUP BY e.exam_name, e.exam_date, r.room_id, "
            "r.room_name, r.capacity "
            "ORDER BY r.room_name"));
    query->setInt(1, examId);
    std::unique_ptr<sql::ResultSet> rows(query->executeQuery());

    std::cout << "\nROOM-WISE REPORT\n";
    std::cout << "------------------------------------------------------------\n";
    bool found = false;
    while (rows->next()) {
        found = true;
        int capacity = rows->getInt("capacity");
        int occupied = rows->getInt("occupied");
        std::cout << "Exam: " << rows->getString("exam_name")
                  << " | Date: " << rows->getString("exam_date") << '\n'
                  << "Room: " << rows->getString("room_name")
                  << " | Capacity: " << capacity
                  << " | Occupied: " << occupied
                  << " | Available: " << capacity - occupied << '\n';
        std::cout << "------------------------------------------------------------\n";
    }
    if (!found) {
        std::cout << "No allocations found for this exam ID.\n";
    }
}

void studentWiseReport(sql::Connection& connection, int examId) {
    std::unique_ptr<sql::PreparedStatement> query(
        connection.prepareStatement(
            "SELECT s.roll_no, s.full_name, e.exam_name, "
            "r.room_name, a.seat_no "
            "FROM ALLOCATION a "
            "JOIN STUDENT s ON s.student_id = a.student_id "
            "JOIN EXAM e ON e.exam_id = a.exam_id "
            "JOIN ROOM r ON r.room_id = a.room_id "
            "WHERE a.exam_id = ? "
            "ORDER BY s.roll_no"));
    query->setInt(1, examId);
    std::unique_ptr<sql::ResultSet> rows(query->executeQuery());

    std::cout << "\nSTUDENT-WISE REPORT\n";
    std::cout << std::left << std::setw(16) << "Roll No"
              << std::setw(26) << "Student"
              << std::setw(22) << "Exam"
              << std::setw(16) << "Room" << "Seat\n";
    std::cout << "------------------------------------------------------------\n";
    while (rows->next()) {
        std::cout << std::left << std::setw(16) << rows->getString("roll_no")
                  << std::setw(26) << rows->getString("full_name")
                  << std::setw(22) << rows->getString("exam_name")
                  << std::setw(16) << rows->getString("room_name")
                  << rows->getInt("seat_no") << '\n';
    }
}

void showRecentAuditLogs(sql::Connection& connection) {
    std::unique_ptr<sql::PreparedStatement> query(
        connection.prepareStatement(
            "SELECT audit_id, action_type, entity_type, entity_id, "
            "details, actor, created_at "
            "FROM AUDIT_LOG ORDER BY audit_id DESC LIMIT 20"));
    std::unique_ptr<sql::ResultSet> rows(query->executeQuery());

    std::cout << "\nRECENT AUDIT LOGS\n";
    std::cout << "------------------------------------------------------------\n";
    while (rows->next()) {
        std::cout << "#" << rows->getInt("audit_id")
                  << " | " << rows->getString("action_type")
                  << " | " << rows->getString("entity_type")
                  << " ID=" << rows->getInt("entity_id")
                  << " | " << rows->getString("actor")
                  << " | " << rows->getString("created_at")
                  << "\n  " << rows->getString("details") << '\n';
    }
}
} // namespace

int main() {
    try {
        auto connection = connectDatabase();
        std::cout << "Connected to exam_management.\n";

        while (true) {
            std::cout << "\n=== REPORTS & REALLOCATION (PHASE 2 - 40%) ===\n"
                      << "1. Room-wise seating report\n"
                      << "2. Student-wise allocation report\n"
                      << "3. View recent audit logs\n"
                      << "0. Exit\n";
            int choice = readInteger("Choose option: ");

            if (choice == 0) break;
            if (choice == 1) {
                roomWiseReport(*connection, readInteger("Enter exam ID: "));
            } else if (choice == 2) {
                studentWiseReport(*connection, readInteger("Enter exam ID: "));
            } else if (choice == 3) {
                showRecentAuditLogs(*connection);
            } else {
                std::cout << "Invalid option.\n";
            }
        }
    } catch (const sql::SQLException& error) {
        std::cerr << "MySQL error " << error.getErrorCode()
                  << ": " << error.what() << '\n'
                  << "Check MySQL service, credentials, Connector/C++, and schema.\n";
        return 1;
    }
    return 0;
}
